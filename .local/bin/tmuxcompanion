#!/bin/sh
# Open a companion tmux session for the project session this is run from.
# Must be run from inside a tmux project session. Each call opens its own
# kitty window; windows share one dark-themed instance via --single-instance,
# so the companion is always dark (see ~/.config/kitty-dark) while the main
# kitty theme stays whatever the theme toggle set.

set -eu

[ -n "${TMUX:-}" ] || { echo "tmuxcompanion: run this from inside tmux" >&2; exit 1; }

session=$(tmux display-message -p '#S')
case "$session" in *-companion)
	echo "tmuxcompanion: '$session' is already a companion session" >&2
	exit 1
	;;
esac

companion="$session-companion"

if ! tmux has-session -t "=$companion" 2>/dev/null; then
	tmux new-session -ds "$companion" -c "$(tmux display-message -p '#{session_path}')"
fi

# The dark instance is created by the first companion and reused afterwards;
# KITTY_CONFIG_DIRECTORY only matters on that first launch.
env -u TMUX KITTY_CONFIG_DIRECTORY="$HOME/.config/kitty-dark" \
	kitty --single-instance --instance-group pi-companion \
	--detach --class pi-companion \
	tmux attach -t "=$companion"
