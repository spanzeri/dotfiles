#!/bin/sh
set -eu

state="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
themes="$HOME/.config/kitty/themes"

case "${1:-toggle}" in
    dark|light) mode=$1 ;;
    toggle) [ "$(cat "$state" 2>/dev/null)" = light ] && mode=dark || mode=light ;;
    *) echo "usage: ${0##*/} [dark|light|toggle]" >&2; exit 2 ;;
esac

[ "$mode" = dark ] && theme="$themes/alabaster-dark.conf" || theme="$themes/vs-light.conf"

mkdir -p "${state%/*}"
printf '%s\n' "$mode" > "$state"
cp "$theme" "$HOME/.config/kitty/current-theme.conf"

# Add --all to set every open window at once; without it only the active window and the default change.
if [ -n "${KITTY_LISTEN_ON:-}" ]; then
    kitten @ set-colors --configured "$theme" 2>/dev/null || true
    match="id:${KITTY_WINDOW_ID:-}"
    [ -n "${KITTY_WINDOW_ID:-}" ] || match=state:focused
    win_pid=$(kitten @ ls --match "$match" 2>/dev/null | python3 -c 'import json, sys
d = json.load(sys.stdin)
for w in d[0]["tabs"][0]["windows"]: print(w["pid"]); sys.exit(0)
' 2>/dev/null || true)
    tty=$(ps -o tty= -p "${win_pid:-0}" 2>/dev/null | tr -d ' ')
    [ -n "$tty" ] && [ "$tty" != "?" ] && pkill -USR1 -t "$tty" -x nvim || true
fi
