# Emacs — runtime/generated state. Same hazard as OrcaSlicer below: Emacs writes
# all of this into ~/.emacs.d, so a folded directory symlink dumps it in the repo.
# Stow with --no-folding; this list is the second line of defence.
.emacs.d/elpa/
.emacs.d/eln-cache/
.emacs.d/tree-sitter/
.emacs.d/transient/
.emacs.d/url/
.emacs.d/var/
.emacs.d/backups/
.emacs.d/auto-save/
.emacs.d/auto-save-list/
.emacs.d/custom.el
.emacs.d/recentf
.emacs.d/savehist
.emacs.d/places
.emacs.d/bookmarks
.emacs.d/projectile-bookmarks.eld
.emacs.d/network-security.data
.emacs.d/*.elc
.emacs.d/*~

# OrcaSlicer — runtime/generated state, never version this.
# Matters because if stow folds .config/OrcaSlicer into a single symlink (it will
# on a machine where that directory does not already exist), the app writes all of
# this straight into the repo. See README.
.config/OrcaSlicer/log/
.config/OrcaSlicer/cache/
.config/OrcaSlicer/ota/
.config/OrcaSlicer/system/
.config/OrcaSlicer/printers/
.config/OrcaSlicer/user_backup-*/
.config/OrcaSlicer/*.sec

# Generated by theme-toggle; real themes live in .config/kitty/themes/.
.config/kitty/current-theme.conf
